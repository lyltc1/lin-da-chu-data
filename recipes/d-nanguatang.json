{
    "id": "d-nanguatang",
    "title": "南瓜汤",
    "tags": "汤",
    "durationMin": 15,
    "notes": "汤里放姜片有提香增鲜的作用。",
    "review": "甘甜爽口",
    "aliases": "",
    "rating": 0,
    "cookCount": 0,
    "createdAt": 1792165716724,
    "updatedAt": 1792165716724,
    "categoryId": "c-soup",
    "ingredients": [
        { "name": "南瓜", "amount": "适量", "unit": "", "group": "主料" },
        { "name": "水", "amount": "适量", "unit": "", "group": "主料" },
        { "name": "姜", "amount": "3", "unit": "片", "group": "调料" },
        { "name": "盐", "amount": "1.5", "unit": "克", "group": "调料" },
        { "name": "鸡精", "amount": "1", "unit": "克", "group": "调料" },
        { "name": "味精", "amount": "1", "unit": "克", "group": "调料" },
        { "name": "食用油", "amount": "5", "unit": "毫升（可选）", "group": "调料" },
        { "name": "葱花", "amount": "适量", "unit": "", "group": "调料" }
    ],
    "steps": [
        {
            "summary": "处理南瓜",
            "text": "南瓜皮比较厚，用刀去皮；南瓜瓤去掉后用水冲洗，切成 1~1.5 厘米厚的块。",
            "images": []
        },
        {
            "summary": "切姜片",
            "text": "姜切三四片，约 1 毫米厚，带皮。",
            "images": []
        },
        {
            "summary": "大火烧水",
            "text": "开 4 档大火，锅中加水（水量就是要盛汤的容器装的水量），下入南瓜块和【姜 3 片】，盖上锅盖，约 2 分钟把水烧开。",
            "images": []
        },
        {
            "summary": "小火慢煮",
            "text": "转 2 档中小火慢煮 10 分钟。用筷子戳南瓜，没有阻力就是煮好了。",
            "images": []
        },
        {
            "summary": "调味",
            "text": "加入【盐 1.5 克】、【鸡精 1 克】、【味精 1 克】和【食用油 5 毫升】（可选）。",
            "images": []
        },
        {
            "summary": "出锅",
            "text": "出锅后撒上少许葱花。",
            "images": []
        }
    ]
}