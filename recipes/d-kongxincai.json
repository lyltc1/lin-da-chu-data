  "steps": [
    {
      "text": "空心菜掐成 2~3 段，掐不动的老梗去掉。",
      "summary": "择菜",
      "images": []
    },
    {
      "text": "手张开轻轻抓洗，用滤网将菜捞出，重复 2~3 遍直至水清。",
      "summary": "洗菜",
      "images": []
    },
    {
      "text": "油下锅烧至冒白烟，或默数十秒。喜欢蒜香的话，可先下大蒜爆出香味。",
      "summary": "热油",
      "images": []
    },
    {
      "text": "转动炒锅，让热油润过锅壁，避免菜叶粘锅。",
      "summary": "润锅",
      "images": []
    },
    {
      "text": "放菜要快速果断，低频翻炒：熟的往上翻，生的往下翻。空心菜容易熟，看到菜叶发蔫即可。",
      "summary": "炒菜",
      "images": []
    },
    {
      "text": "快熟时放盐，然后放味精和鸡精。",
      "summary": "快熟时放盐、味精、鸡精",
      "images": []
    }
  ]
}