    "steps":  [
                  {
                      "text":  "菜苔根部切十字花刀，再分成两半，下面那一半保留 3 片叶子；花打掉，比较老的皮切掉。",
                      "summary":  "择菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "三颗大蒜切片，3 个干辣椒切成 1cm 的段，另备 15 粒干花椒。",
                      "summary":  "备料",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "水烧开后下菜苔，焯 1 分钟~1 分半钟，捞出用冷水冲，可以保持爽脆口感。",
                      "summary":  "焯水",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "放油之后马上放干花椒和干辣椒，干辣椒微微有点发黑的时候放大蒜。",
                      "summary":  "爆香",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "放大蒜后马上放菜，开始翻炒。",
                      "summary":  "炒菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "快熟的时候放盐，然后是味精和鸡精。",
                      "summary":  "快熟时放盐、味精、鸡精",
                      "images":  [

                                 ]
                  }
              ]
}