    "steps":  [
                  {
                      "text":  "取叶尖，去掉老茎。",
                      "summary":  "择菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "手张开轻轻抓洗，用滤网将菜捞出，重复 2~3 遍直至水清。",
                      "summary":  "洗菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "【食用油 15 毫升】下锅烧至冒白烟，或默数十秒。转动炒锅润锅。喜欢辣味的话，可先下【干花椒 15 粒】和【干辣椒 3 个】，干辣椒微微发黑时放【大蒜 3 瓣】爆香。",
                      "summary":  "热油",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "放菜要快速果断，低频翻炒：熟的往上翻，生的往下翻。豆腐菜容易熟，看到菜叶发蔫即可。",
                      "summary":  "炒菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "快熟时放【盐 3 克】，然后放【味精 1 克】和【鸡精 1 克】。",
                      "summary":  "快熟时放盐、味精、鸡精",
                      "images":  [

                                 ]
                  }
              ]
}