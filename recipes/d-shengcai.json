    "steps":  [
                  {
                      "text":  "把生菜每片叶子择下来，根部去掉。",
                      "summary":  "择菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "手张开轻轻抓洗，用滤网将菜捞出，重复 2~3 遍直至水清。",
                      "summary":  "洗菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "油下锅烧至冒白烟，或默数十秒。转动炒锅润锅。喜欢蒜香的话，可先下大蒜爆出香味。",
                      "summary":  "热油",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "放菜要快速果断，低频翻炒：熟的往上翻，生的往下翻。生菜极易熟，菜叶一塌软就要起锅。",
                      "summary":  "炒菜",
                      "images":  [

                                 ]
                  },
                  {
                      "text":  "快熟时放盐，然后放味精和鸡精。",
                      "summary":  "放调料",
                      "images":  [

                                 ]
                  }
              ]
}